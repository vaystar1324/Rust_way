[sub_resource type="VoxelMesherTransvoxel" id="VoxelMesherTransvoxel_33hfs"]

[sub_resource type="Shader" id="Shader_s1mi3"]
code = "shader_type spatial;

// === Текстуры ===
group_uniforms Textures;
uniform sampler2D sand_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D sand_normal : hint_normal, filter_linear_mipmap, repeat_enable;
uniform sampler2D sand_roughness : hint_roughness_r, filter_linear_mipmap, repeat_enable;

uniform sampler2D rock_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D rock_normal : hint_normal, filter_linear_mipmap, repeat_enable;
uniform sampler2D rock_roughness : hint_roughness_r, filter_linear_mipmap, repeat_enable;

uniform sampler2D road : source_color, filter_linear_mipmap, repeat_enable;

// === Настройки triplanar ===
group_uniforms Triplanar;
uniform float texture_scale : hint_range(0.01, 2.0) = 0.08;
uniform float blend_sharpness : hint_range(1.0, 16.0) = 6.0;

// === Смешивание по наклону ===
group_uniforms Slope_Blend;
uniform float sand_threshold : hint_range(0.0, 1.0) = 0.55;
uniform float blend_softness : hint_range(0.01, 0.5) = 0.18;

// === Цвета и материалы ===
group_uniforms Material;
uniform vec3 sand_tint : source_color = vec3(1.0, 0.92, 0.75);
uniform vec3 rock_tint : source_color = vec3(0.85, 0.78, 0.65);
uniform float sand_roughness_mul : hint_range(0.0, 2.0) = 1.1;
uniform float rock_roughness_mul : hint_range(0.0, 2.0) = 0.95;
uniform float normal_strength : hint_range(0.0, 2.0) = 1.0;

varying vec3 v_world_pos;
varying vec3 v_world_normal;

void vertex() {
	v_world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	v_world_normal = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

vec4 triplanar_texture(sampler2D tex, vec3 world_pos, vec3 blend) {
	vec4 x = texture(tex, world_pos.yz);
	vec4 y = texture(tex, world_pos.xz);
	vec4 z = texture(tex, world_pos.xy);
	return x * blend.x + y * blend.y + z * blend.z;
}

void fragment() {
	vec3 normal = normalize(v_world_normal);
	
	// Вместо обычного blend сделай так:
	vec3 blend = abs(normal);
	blend = pow(blend, vec3(12.0)); // было 6.0 — сильно увеличиваем резкость
	blend /= (blend.x + blend.y + blend.z);

	// Дополнительно усиливаем боковые проекции на крутых стенах
	float steepness = 1.0 - abs(normal.y);
	blend.x = max(blend.x, steepness * 0.65);
	blend.z = max(blend.z, steepness * 0.65);
	blend.y *= (1.0 - steepness * 0.7);
	blend /= (blend.x + blend.y + blend.z);

	vec3 uv_pos = v_world_pos * texture_scale;
	
	// Сэмплируем основные текстуры
	vec3 sand_col = triplanar_texture(sand_albedo, uv_pos, blend).rgb * sand_tint;
	vec3 rock_col = triplanar_texture(rock_albedo, uv_pos, blend).rgb * rock_tint;
	
	vec3 sand_nrm = triplanar_texture(sand_normal, uv_pos, blend).rgb;
	vec3 rock_nrm = triplanar_texture(rock_normal, uv_pos, blend).rgb;
	
	float sand_rough = triplanar_texture(sand_roughness, uv_pos, blend).r * sand_roughness_mul;
	float rock_rough = triplanar_texture(rock_roughness, uv_pos, blend).r * rock_roughness_mul;
	
	// Смешивание по наклону (песок / камень)
	float slope = normal.y;
	float sand_factor = smoothstep(sand_threshold - blend_softness, sand_threshold + blend_softness, slope);
	
	vec3 base_albedo = mix(rock_col, sand_col, sand_factor);
	vec3 base_normal = mix(rock_nrm, sand_nrm, sand_factor);
	float base_rough = mix(rock_rough, sand_rough, sand_factor);
	
	// === ДОРОГА ===
	float road_half_width = 8.0;
	float road_dist = abs(v_world_pos.x);
	float road_factor = 1.0 - smoothstep(road_half_width * 0.5, road_half_width * 1.05, road_dist);
	road_factor = pow(road_factor, 1.4);
	
	// Текстура дороги
	vec3 road_color = triplanar_texture(rock_albedo, uv_pos, blend).rgb;
	road_color *= 0.4; // чуть затемняем
	
	// Финальный цвет
	ALBEDO = mix(base_albedo, road_color, road_factor);
	
	// Normal
	NORMAL_MAP = mix(vec3(0.5, 0.5, 1.0), base_normal, normal_strength);
	NORMAL_MAP = mix(NORMAL_MAP, vec3(0.5, 0.5, 1.0), road_factor * 0.7);
	
	// Roughness
	ROUGHNESS = mix(base_rough, 0.55, road_factor);
	
	METALLIC = 0.0;
	SPECULAR = 0.35;
}"

